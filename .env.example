# ============================================================
# サーバー専用（クライアントへ絶対に公開しない）
# ============================================================

# Supabase（ローカル開発: `pnpm db:start` の出力から取得）
# 他の Supabase プロジェクトとの衝突を避けるため、ポートは 543xx ではなく
# 544xx を使う（supabase/config.toml で API 54421 / DB 54422 / Studio 54423）
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_ANON_KEY=
# service role key はサーバー専用。NEXT_PUBLIC_ を付けないこと
SUPABASE_SERVICE_ROLE_KEY=

# Auth.js（`pnpm dlx auth secret` または `openssl rand -base64 32` で生成）
AUTH_SECRET=

# Google OAuth（Google Cloud Console で作成）
# 承認済みリダイレクト URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ============================================================
# 公開可（Optional module で browser client を使う場合のみ設定）
# ============================================================
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
